	// --- coop: ventana del boton "Co-op" de CoD2 (la agrega tools/make_ui2.py al final de ui/main.menu) ---
	menuDef
	{
		name "coop_popmenu"
		visible 0
		fullscreen 0
		rect 184 70 275 330
		focusColor GLOBAL_FOCUSED_COLOR
		style 1
		border 1
		popup
		onESC { close coop_popmenu; open main }

		itemDef
		{
			name backimage2fade
			style WINDOW_STYLE_SHADER
			rect -312 -72 896 484
			background "white"
			forecolor 0 0 0 0.3
			backcolor 0 0 0 0.3
			visible 1
			decoration
		}
		itemDef
		{
			name backimage2fade
			style WINDOW_STYLE_SHADER
			rect -130 2 535 335
			background "popmenu_bg"
			visible 1
			decoration
		}
		itemDef
		{
			name backimage2fade
			style WINDOW_STYLE_SHADER
			rect -30 20 335 24
			background "popmenu_goldline"
			visible 1
			decoration
		}
		itemDef
		{
			name title
			text "Co-op - up to 4 players"
			style 0
			textscale HEADER_SIZE
			textstyle ITEM_TEXTSTYLE_SHADOWED
			rect 137 25 110 20
			textalign 1
			textalignx -7
			textaligny 5
			decoration
			forecolor POPMENU_HEADER_COLOR
			visible 1
		}

		// crear: abre el puerto; despues se elige Nueva partida, Seleccion de mision o Continuar como siempre
		itemDef
		{
			name		host
			text		"Host game"
			type		1
			textscale	.4
			style		UI_BUTTON_STYLE
			textfont	UI_FONT_NORMAL
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			rect		60 45 155 26
			textalign	1
			textalignx	77
			textaligny	20
			forecolor	UI_BUTTON_TEXT_COLOR
			visible		1
			action { play "mouse_click"; exec "coop2host"; }
			mouseEnter { play "mouse_over"; }
		}

		// Steam: amigos que crearon partida (el mod pone los dvars cada 2 s, ver SteamFrame en src/cod2.cpp;
		// ui_coop2_steamon<n> = 0 esconde el boton)
		itemDef
		{
			name		steaminfo
			rect		15 74 245 14
			type		ITEM_TYPE_TEXT
			style		0
			dvar		"ui_coop2_steam"
			textalign	ITEM_ALIGN_CENTER
			textalignx	122
			textaligny	11
			textscale	.22
			forecolor	1 1 1 .8
			visible		1
			decoration
		}
		itemDef
		{
			name		friend1
			type		1
			dvar		"ui_coop2_steam1"
			dvarTest	"ui_coop2_steamon1"
			showDvar	{ "1" }
			textscale	.3
			style		UI_BUTTON_STYLE
			textfont	UI_FONT_NORMAL
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			rect		30 92 215 20
			textalign	1
			textalignx	107
			textaligny	15
			forecolor	UI_BUTTON_TEXT_COLOR
			visible		1
			action { play "mouse_click"; exec "coop2joinsteam 1"; }
			mouseEnter { play "mouse_over"; }
		}
		itemDef
		{
			name		friend2
			type		1
			dvar		"ui_coop2_steam2"
			dvarTest	"ui_coop2_steamon2"
			showDvar	{ "1" }
			textscale	.3
			style		UI_BUTTON_STYLE
			textfont	UI_FONT_NORMAL
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			rect		30 114 215 20
			textalign	1
			textalignx	107
			textaligny	15
			forecolor	UI_BUTTON_TEXT_COLOR
			visible		1
			action { play "mouse_click"; exec "coop2joinsteam 2"; }
			mouseEnter { play "mouse_over"; }
		}
		itemDef
		{
			name		friend3
			type		1
			dvar		"ui_coop2_steam3"
			dvarTest	"ui_coop2_steamon3"
			showDvar	{ "1" }
			textscale	.3
			style		UI_BUTTON_STYLE
			textfont	UI_FONT_NORMAL
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			rect		30 136 215 20
			textalign	1
			textalignx	107
			textaligny	15
			forecolor	UI_BUTTON_TEXT_COLOR
			visible		1
			action { play "mouse_click"; exec "coop2joinsteam 3"; }
			mouseEnter { play "mouse_over"; }
		}

		// unirse: IP del anfitrion (dvar coop2_ip; coop2join sin argumento la usa)
		itemDef
		{
			name		ip
			type		ITEM_TYPE_EDITFIELD
			text		"Host IP: "
			dvar		"coop2_ip"
			maxchars	40
			maxPaintChars	20
			rect		30 166 215 20
			style		1
			border		1
			bordercolor	.5 .5 .5 .5
			textalign	ITEM_ALIGN_LEFT
			textalignx	6
			textaligny	15
			textscale	.25
			backcolor	0 0 0 .4
			forecolor	.9 .9 .9 1
			visible		1
			action { play "mouse_click"; }
			mouseEnter { play "mouse_over"; }
		}
		itemDef
		{
			name		join
			text		"Join"
			type		1
			textscale	.4
			style		UI_BUTTON_STYLE
			textfont	UI_FONT_NORMAL
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			rect		60 190 155 26
			textalign	1
			textalignx	77
			textaligny	20
			forecolor	UI_BUTTON_TEXT_COLOR
			visible		1
			action { play "mouse_click"; exec "coop2join"; }
			mouseEnter { play "mouse_over"; }
		}
		// dano entre jugadores: lo decide el anfitrion (coop2_friendlyfire)
		itemDef
		{
			name		friendlyfire
			type		ITEM_TYPE_YESNO
			text		"Friendly fire: "
			dvar		"coop2_friendlyfire"
			rect		30 222 215 20
			style		1
			border		1
			bordercolor	.5 .5 .5 .5
			textalign	ITEM_ALIGN_LEFT
			textalignx	6
			textaligny	15
			textscale	.25
			backcolor	0 0 0 .4
			forecolor	.9 .9 .9 1
			visible		1
			action { play "mouse_click"; }
			mouseEnter { play "mouse_over"; }
		}
		// salir de la partida (el que se une vuelve al menu; el host deja de crear partida)
		itemDef
		{
			name		leave
			text		"Disconnect"
			type		1
			textscale	.35
			style		UI_BUTTON_STYLE
			textfont	UI_FONT_NORMAL
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			rect		60 247 155 22
			textalign	1
			textalignx	77
			textaligny	17
			forecolor	UI_BUTTON_TEXT_COLOR
			visible		1
			action { play "mouse_click"; exec "coop2leave"; }
			mouseEnter { play "mouse_over"; }
		}
		itemDef
		{
			name		back
			text		"@MENU_BACK"
			type		1
			textscale	.35
			style		UI_BUTTON_STYLE
			textfont	UI_FONT_NORMAL
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			rect		60 271 155 22
			textalign	1
			textalignx	77
			textaligny	17
			forecolor	UI_BUTTON_TEXT_COLOR
			visible		1
			action { play "mouse_click"; close coop_popmenu; open main; }
			mouseEnter { play "mouse_over"; }
		}

		// estado (lo escribe el mod en ui_coop2_status)
		itemDef
		{
			name		status
			rect		15 296 245 34
			type		ITEM_TYPE_TEXT
			style		0
			textstyle	ITEM_TEXTSTYLE_SHADOWED
			autowrapped
			dvar		"ui_coop2_status"
			textalign	ITEM_ALIGN_CENTER
			textalignx	122
			textaligny	12
			textscale	.22
			forecolor	1 1 .6 1
			visible		1
			decoration
		}
	}
